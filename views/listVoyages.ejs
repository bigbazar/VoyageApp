<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <link rel='stylesheet' href='/stylesheets/style.css' />

        
    <!-- jQuery une seule fois, avant Bootstrap qui en dépend -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>

    <script src="/javascripts/listVoyages.js" defer></script>

    <title><%= title %></title>
  </head>

  <body>
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-success alert-dismissible fade show m-2" role="status">
        <%= message %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
      </div>
    <% } %>

    <!-- Message affiché quand la validation serveur refuse le formulaire -->
    <% if (typeof erreur !== 'undefined' && erreur) { %>
      <div class="alert alert-danger m-2" role="alert">
        <strong>Enregistrement refusé :</strong> <%= erreur %>
      </div>
    <% } %>

    <!-- Modal -->
    <div class="modal fade" id="modalVoyage" tabindex="-1" role="dialog" aria-labelledby="modalVoyageLongTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modalVoyageLongTitle">Paramétrer un voyage</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <!-- Création : POST /voyages. Édition : le script ajoute l'identifiant dans
                 l'URL et active le champ _method pour obtenir PUT /voyages/:id -->
            <form method="post" action="/voyages" id="formVoyage">
              <!-- Jeton CSRF : le serveur refuse toute modification sans ce champ -->
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="_method" value="PUT" id="methodeUpdate" disabled />
              <div class="mb-3">
                <label class="form-label" for="destination">Destination :</label>
                <input class="form-control" placeholder="Destination"  id="destination" name="destination" required maxlength="80"/>
              </div>
              <div class="mb-3">
                <label class="form-label" for="pays">Pays :</label>
                <input class="form-control" placeholder="Pays" id="pays" name="pays" required maxlength="60"/>
              </div>
              <div class="mb-3">
                <label class="form-label" for="prix">Prix :</label>
                <input class="form-control" type="number" placeholder="Prix" id="prix" name="prix" required min="0" max="1000000" step="0.01"/>
              </div>
              <div class="mb-3">
                <label class="form-label" for="devise">Devise :</label>
                <input class="form-control" placeholder="Devise" id="devise" name="devise" maxlength="8"/>
              </div>
              <div class="mb-3">
                <label class="form-label" for="image">Image :</label>
                <input class="form-control" placeholder="Image" id="image" name="image" maxlength="500"/>
              </div>
              <div class="mb-3">
                <label class="form-label" for="titre">Titre :</label>
                <input class="form-control" placeholder="Titre" id="titre" name="titre" maxlength="120"/>
              </div>      
              <div class="mb-3">
                <label class="form-label" for="description">Description :</label>
                <input class="form-control" placeholder="Description" id="description" name="description" maxlength="2000"/>
              </div>            
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
                <button type="submit" class="btn btn-primary" id="modalSubmit">Mettre à jour</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <%- include('partials/entete') %>

    <!-- La recherche est une simple lecture : un GET, dont l'URL reste partageable -->
    <form class="form-inline justify-content-start mb-4" id="formSearch" method="get" action="/voyages">
      <input class="form-control mr-sm-2" placeholder="Recherche" aria-label="Recherche" id="recherche" name="q" value="<%= recherche %>"/>
      <button class="btn btn-outline-info my-2 my-sm-0" type="submit" aria-label="Rechercher">
        <i class="fas fa-search" aria-hidden="true"></i>
      </button>
      <button class="btn btn-outline-info my-2 my-sm-0 ml-3" type="button" id="dialogVoyage"
              data-toggle="modal" data-target="#modalVoyage">
        <i class="fas fa-plus mr-2" aria-hidden="true"></i> Ajouter Voyage
      </button>
    </form>

    <!-- Cards des destinations -->
    <div class="row">
      <% if (voyages.length === 0) { %>
        <div class="alert alert-info m-3" role="status">Aucun voyage ne correspond à votre recherche.</div>
      <% } %>
      <% voyages.forEach(voyage => { %>
        <div class="col-12 col-sm-6 col-lg-4 mb-3">
          <div class="card h-100 border-dark text-center">

          <div class="position-relative">
            <!-- Bouton Supprimer -->
            <form action="/voyages/<%= voyage.id %>" method="post"
                  data-confirmation="Supprimer le voyage à <%= voyage.destination %> ?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-danger btn-sm position-absolute rounded-circle"
                        style="top: 0.5rem; right: 0.5rem;"
                        aria-label="Supprimer le voyage à <%= voyage.destination %>">
                  <i class="fas fa-trash" aria-hidden="true"></i>
                </button>
            </form>

            <a href="/voyages/<%= voyage.id %>">
              <img class="card-img-top img-top" src="<%= voyage.image %>" alt="Voyage à <%= voyage.destination %>">
            </a>
          </div>

          <div class="card-body d-flex flex-column">
            <div class="card-title row justify-content-center">
              <!-- Les données passent par data-voyage (JSON échappé) : les apostrophes des
                   descriptions ne cassent plus le JavaScript et ne peuvent plus être injectées. -->
              <button class="btn rounded-circle btn-editer" type="button" data-toggle="modal" data-target="#modalVoyage"
                      data-voyage="<%= JSON.stringify(voyage) %>"
                      aria-label="Modifier le voyage à <%= voyage.destination %>">
                  <i class="fas fa-edit" aria-hidden="true"></i>
              </button>
              <h5 class="m-1"><%= voyage.destination %></h5>
            </div>
            <h6 class="card-subtitle mb-2 text-muted"><%= voyage.pays %></h6>
            <!-- Dans le cas d'un seul voyage affiché, information complémentaire -->
            <% if (voyages.length === 1) { %>
              <p class="card-text"><%= voyage.description %></p>
            <% } %>
            <p class="mt-auto mb-0">
              <span class="badge badge-primary p-2">
                <%= new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 2 }).format(voyage.prix) %> <%= voyage.devise %>
              </span>
            </p>
          </div>
          </div>
        </div>
      <% }) %>
    </div>

  </body>

</html>
